/**
 * AI News Digest (AIニュース・ダイジェスト) — Cloudflare Workers config
 * https://developers.cloudflare.com/workers/framework-guides/web-apps/nextjs/
 *
 * main points not at the .open-next/worker.js generated by @opennextjs/cloudflare
 * but at worker.js, which wraps it: it gives every HTML response a per-request
 * script nonce (lib/csp-nonce.ts) and adds the scheduled handler for Cron Triggers.
 * Pointing main back at .open-next/worker.js silently restores script-src
 * 'unsafe-inline' and drops the crons (lib/worker-entry.test.ts guards it).
 *
 * CRON_SECRET / GEMINI_API_KEY / SUPABASE_SERVICE_ROLE_KEY and the like are set
 * with wrangler secret (never written in this config file).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-news-feed-app",
  "main": "worker.js",
  "compatibility_date": "2026-08-16",
  // Required to run Next.js. The date must be 2024-09-23 or later.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // ISR cache (open-next.config.ts): rendered pages live in R2, a Durable Object queue
  // regenerates stale ones, and the queue calls this Worker back through WORKER_SELF_REFERENCE.
  // The bucket was created by the owner (wrangler r2 bucket create ai-news-feed-app-cache).
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "ai-news-feed-app-cache",
    },
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ai-news-feed-app",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"],
    },
  ],
  // Replaces the crons in vercel.json. Keep in sync with CRON_PATHS in worker.js.
  "triggers": {
    "crons": [
      "0 21 * * *", // Generate the daily digest (JST 06:00)
      "0 4 * * *", // Clean up old records
    ],
  },
  "observability": {
    "enabled": true,
  },
}
